DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=5000
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Role-based email policy configuration
# Optional comma-separated list of approved partner school domains (e.g. hnu.edu.ph,bisu.edu.ph,universityofbohol.edu.ph)
ALLOWED_SCHOOL_EMAIL_DOMAINS=
STRICT_SCHOOL_DOMAIN_ALLOWLIST=false

# IMPORTANT: Confirm the official Tagbilaran City LGU email domain(s) before setting ALLOWED_LGU_EMAIL_DOMAINS.
# Do not guess an unconfirmed domain. Required before provisioning new LGU Program Admin accounts.
ALLOWED_LGU_EMAIL_DOMAINS=

# Optional comma-separated list of official barangay email domains (Barangay Coordinators may also use @gmail.com or ALLOWED_LGU_EMAIL_DOMAINS)
ALLOWED_BARANGAY_EMAIL_DOMAINS=

# Proposed initial developer allowlist (requires explicit CLI bootstrap + email token verification)
INITIAL_DEVELOPER_ALLOWLIST=cuevas.sharee_angela@hnu.edu.ph,medrina.nina_marie@hnu.edu.ph,palaca.szarina@hnu.edu.ph

# Genuine email verification delivery (leave false until a real SMTP/transactional email provider is configured)
EMAIL_VERIFICATION_ENABLED=false
SMTP_HOST=
SMTP_FROM=
